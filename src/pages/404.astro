---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Hakhyun Kim">
  <div class="container nf">
    <h1 class="gradient-text">404</h1>
    <p>페이지를 찾을 수 없습니다 · Page not found</p>
    <p><a href="/">← Back home</a></p>
  </div>
</Base>

<style>
  .nf {
    text-align: center;
    padding: 7rem 0;
  }

  .nf h1 {
    font-size: 5rem;
    font-weight: 800;
  }

  .nf p {
    margin-top: 0.6rem;
    color: var(--text-soft);
  }
</style>
