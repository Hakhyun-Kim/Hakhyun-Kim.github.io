---
interface Props {
  title: string;
  description?: string;
  lang?: string;
  alternate?: string;
  autoRedirect?: boolean;
}

const {
  title,
  description = 'Hakhyun Kim builds real-time 3D software — game engines, XR, simulation — and writes down what happens when AI agents do the designing, balancing, and verifying.',
  lang = 'en',
  alternate,
  autoRedirect = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isKo = lang === 'ko';
const prefix = isKo ? '/ko' : '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {alternate && (
      <link rel="alternate" hreflang={isKo ? 'en' : 'ko'} href={new URL(alternate, Astro.site)} />
    )}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script is:inline>
      // set theme before first paint to avoid flash
      const saved = localStorage.getItem('theme');
      const theme =
        saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    </script>
    {autoRedirect && (
      <script is:inline>
        // client-side only: static GitHub Pages has no server to read Accept-Language,
        // so a Korean-browser visitor gets bounced to /ko/ unless they've already chosen.
        (function () {
          try {
            if (localStorage.getItem('lang-pref')) return;
            var isKoBrowser = (navigator.language || '').toLowerCase().startsWith('ko');
            if (isKoBrowser) location.replace('/ko/');
          } catch (e) {}
        })();
      </script>
    )}
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav">
        <a href={`${prefix}/`} class="brand" aria-label="Home">
          <span class="brand-mark">HK</span>
          <span class="brand-name">Hakhyun Kim</span>
        </a>
        <div class="nav-links">
          <a href={`${prefix}/#projects`}>{isKo ? '프로젝트' : 'Projects'}</a>
          <a href={`${prefix}/#research`}>{isKo ? '연구' : 'Research'}</a>
          <a href="/blog/">{isKo ? '블로그' : 'Blog'}</a>
          <a href={`${prefix}/#career`}>{isKo ? '경력' : 'Career'}</a>
          <a href={`${prefix}/#contact`}>{isKo ? '연락처' : 'Contact'}</a>
          {alternate && (
            <a href={alternate} id="lang-toggle" data-set-lang={isKo ? 'en' : 'ko'}>
              {isKo ? 'EN' : '한국어'}
            </a>
          )}
          <button id="theme-toggle" aria-label="Toggle color theme" title="Toggle theme">
            <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          </button>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© 2026 Hakhyun Kim</p>
        <p class="footer-links">
          <a href="mailto:hakhyun.2023@gmail.com">{isKo ? '이메일' : 'Email'}</a>
          <a href="https://github.com/Hakhyun-Kim" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.linkedin.com/in/hakhyunkim/" target="_blank" rel="noopener">LinkedIn</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
      document.getElementById('lang-toggle')?.addEventListener('click', (e) => {
        const setLang = e.currentTarget.getAttribute('data-set-lang');
        if (setLang) localStorage.setItem('lang-pref', setLang);
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.6rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-weight: 700;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--gradient);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-size: 0.95rem;
  }

  .nav-links a {
    color: var(--text-soft);
    font-weight: 500;
  }

  .nav-links a:hover {
    color: var(--text);
    text-decoration: none;
  }

  #theme-toggle {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-soft);
    cursor: pointer;
  }

  #theme-toggle:hover {
    color: var(--text);
    border-color: var(--text-faint);
  }

  :root[data-theme='dark'] .icon-moon,
  :root:not([data-theme='dark']) .icon-sun {
    display: none;
  }

  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    font-size: 0.92rem;
    color: var(--text-faint);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .footer-links {
    display: flex;
    gap: 1.2rem;
  }

  @media (max-width: 640px) {
    .brand-name {
      display: none;
    }

    .brand {
      flex-shrink: 0;
    }

    /* the link row is wider than a phone, so let it scroll inside itself —
       otherwise it pushes the whole page into a horizontal scroll */
    .nav-links {
      gap: 1rem;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .nav-links::-webkit-scrollbar {
      display: none;
    }

    .nav-links > * {
      flex-shrink: 0;
    }
  }
</style>
