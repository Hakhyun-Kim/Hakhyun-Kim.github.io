    img: '/projects/math-runner.png',
    tags: [
      { en: 'Roblox', ko: 'Roblox' },
      { en: 'Published', ko: '퍼블리시 완료' },
      { en: 'EdTech', ko: '에듀테크' },
    ],
  },
];

const skills = [
  { en: 'C / C++', ko: 'C / C++' },
  { en: 'C#', ko: 'C#' },
  { en: 'Unreal Engine', ko: 'Unreal Engine' },
  { en: 'Unity', ko: 'Unity' },
  { en: 'OpenXR / VR / MR', ko: 'OpenXR / VR / MR' },
  { en: 'CARLA / AV Simulation', ko: 'CARLA / 자율주행 시뮬레이션' },
  { en: 'Performance Profiling', ko: '성능 프로파일링' },
  { en: '3D Graphics Pipeline', ko: '3D 그래픽스 파이프라인' },
  { en: 'Multi-platform (PS / Xbox / Mobile)', ko: '멀티플랫폼(PS/Xbox/모바일)' },
  { en: 'Developer Relations', ko: '개발자 관계(DevRel)' },
  { en: 'Technical Writing', ko: '기술 문서 작성' },
  { en: 'Blockchain / Web3', ko: '블록체인 / Web3' },
  { en: 'Solidity / Smart Contracts', ko: 'Solidity / 스마트 컨트랙트' },
  { en: 'AI-agent Workflows', ko: 'AI 에이전트 워크플로우' },
  { en: 'RAG / Vector Search', ko: 'RAG / 벡터 검색' },
  { en: 'MCP Servers', ko: 'MCP 서버' },
];

const title = isKo
  ? '김학현 — 게임 엔진 & 실시간 3D 소프트웨어 엔지니어'
  : 'Hakhyun Kim — Software Engineer · Game & Real-time 3D';
const description = isKo
  ? '김학현 — 게임 엔진, 실시간 3D, XR, 개발자 관계(DevRel) 전문 소프트웨어 엔지니어.'
  : 'Hakhyun Kim — software engineer specializing in game engines, real-time 3D, XR, and developer relations.';
const alternate = isKo ? '/' : '/ko/';
---

<Base title={title} description={description} lang={lang} alternate={alternate} autoRedirect={!isKo}>
  <!-- hero -->
  <section class="hero">
    <div class="container">
      {isKo ? (
        <p class="hello">안녕하세요 👋 저는</p>
      ) : (
        <p class="hello">안녕하세요 👋 I'm</p>
      )}
      <h1>Hakhyun <span class="gradient-text">Kim</span></h1>
      {isKo ? (
        <p class="tagline">
          게임, 게임 엔진, XR, 시뮬레이션, <strong>개발자 관계(DevRel)</strong> 분야에서 15년 이상
          일해온 소프트웨어 엔지니어입니다. 라그나로크 온라인 클라이언트 코드로 시작해 하복(Havok)과
          유니티(Unity)에서 엔진 지원을, Varjo에서 human-eye-resolution VR을, 42dot에서 자율주행
          시뮬레이션을, 솔라나 재단에서 게임 생태계 엔지니어링을 거쳤습니다.
        </p>
      ) : (
        <p class="tagline">
          Software engineer with 15+ years across <strong>games, game engines, XR, simulation, and
          developer relations</strong> — from Ragnarok Online client code to engine support at Havok
          and Unity, human-eye-resolution VR at Varjo, autonomous-driving simulation at 42dot, and
          games ecosystem engineering at Solana Foundation.
        </p>
      )}
      {isKo ? (
        <p class="now">
          📚 현재 <strong>딥러닝</strong>을 공개적으로 공부하며 기록 중입니다 — Stanford 40
          Actions로 ResNet18을 파인튜닝 중이고(목표 80% 테스트 정확도), 다음은 MPII 데이터셋으로
          Simple Baselines 기반 포즈 추정을 진행할 예정입니다.
          <a href="https://github.com/Hakhyun-Kim/deep-learning-study" target="_blank" rel="noopener">분류 저장소</a> ·
          <a href="https://hakhyun-kim.github.io/deep-learning-study/" target="_blank" rel="noopener">실험 대시보드</a> ·
          <a href="https://github.com/Hakhyun-Kim/pose-estimation-study" target="_blank" rel="noopener">포즈 추정 저장소</a>
        </p>
      ) : (
        <p class="now">
          📚 Currently studying <strong>deep learning</strong> in public — fine-tuning
          ResNet18 on Stanford 40 Actions (targeting 80% test accuracy), then pose estimation
          with Simple Baselines on MPII.
          <a href="https://github.com/Hakhyun-Kim/deep-learning-study" target="_blank" rel="noopener">Classification repo</a> ·
          <a href="https://hakhyun-kim.github.io/deep-learning-study/" target="_blank" rel="noopener">live experiment dashboard</a> ·
          <a href="https://github.com/Hakhyun-Kim/pose-estimation-study" target="_blank" rel="noopener">pose estimation repo</a>
        </p>
      )}
      <div class="hero-actions">
        <a class="btn btn-primary" href="#contact">{isKo ? '연락하기' : 'Get in touch'}</a>
        {isKo ? (
          <a class="btn" href="/blog/">블로그 읽기</a>
        ) : (
          <a class="btn" href="/blog/">Read the blog <span class="ko">한국어</span></a>
        )}
      </div>
      <ul class="skills" aria-label="Core skills">
        {skills.map((s) => <li class="chip">{s[lang]}</li>)}
      </ul>
    </div>
  </section>

  <!-- experience -->
  <section id="experience" class="container section">
    <h2 class="section-title">{isKo ? '경력' : 'Experience'}</h2>
    <ol class="timeline">
      {
        experience.map((job) => (
          <li>
            <div class="tl-head">
              <h3>{job.company}</h3>
              <span class="tl-period">{job.period}</span>
            </div>
            <p class="tl-role">
              {job.role} · <span class="tl-loc">{job.location[lang]}</span>
            </p>
            <ul class="tl-points">
              {job.points.map((p) => (
                <li>{p[lang]}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- projects -->
  <section id="projects" class="container section">
    <h2 class="section-title">{isKo ? '최근 프로젝트' : 'Recent Projects'}</h2>
    <p class="section-note">
      {isKo
        ? '2026년, AI 에이전트 개발 워크플로우로 만든 프로젝트들입니다 — 한 명의 엔지니어가 프롬프트에서 출시까지 얼마나 멀리 갈 수 있는지 실험하고 있습니다.'
        : 'Built in 2026 with AI-agent development workflows — exploring how far one engineer can take an idea from prompt to published product.'}
    </p>
    <div class="cards">
      {
        projects.map((p) => (
          <article class="card">
            <img src={p.img} alt={`${p.name} screenshot`} loading="lazy" />
            <div class="card-body">
              <h3>
                {p.link ? (
                  <a href={p.link} target="_blank" rel="noopener">
                    {p.name} ↗
                  </a>
                ) : (
                  p.name
                )}
              </h3>
              <p>{p.desc[lang]}</p>
              <p class="card-tags">
                {p.tags.map((t) => (
                  <span class="chip">{t[lang]}</span>
                ))}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- talks -->
  <section id="talks" class="container section">
    <h2 class="section-title">{isKo ? '발표 & 강의' : 'Talks & Teaching'}</h2>
    <div class="talks">
      {
        talks.map((t) => (
          <div class="talk">
            <h3>{t.title[lang]}</h3>
            <p>{t.desc[lang]}</p>
          </div>
        ))
      }
    </div>

    <h3 class="slides-title">{isKo ? '슬라이드' : 'Slides'}</h3>
    <ul class="slide-list">
      {
        slides.map((s) => (
          <li>
            <a href={s.url} target="_blank">
              <span class="slide-name">{s.title}</span>
              <span class="slide-meta">{s.meta[lang]} · PDF</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- blog -->
  <section id="blog" class="container section">
    <h2 class="section-title">{isKo ? '블로그 최근 글' : 'From the Blog'}</h2>
    <p class="section-note">
      개발자로 살아온 기록 — 2010년부터 쓴 글들을 블로그스팟에서 옮겨왔습니다.
    </p>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="post-title">{post.data.title}</span>
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            </a>
          </li>
        ))
      }
    </ul>
    <p><a class="more" href="/blog/">{isKo ? '전체 글 보기 →' : 'All posts →'}</a></p>
  </section>

  <!-- contact -->
  <section id="contact" class="container section">
    <h2 class="section-title">{isKo ? '연락처' : 'Contact'}</h2>
    <p>
      {isKo
        ? '개발자 관계(DevRel), 테크니컬 어카운트 매니지먼트, 엔진/그래픽스 엔지니어링 분야의 포지션에 열려 있습니다 — 서울 또는 리모트.'
        : 'Open to roles in developer relations, technical account management, and engine/graphics engineering — Seoul or remote.'}
    </p>
    <div class="contact-links">
      <a class="btn btn-primary" href="mailto:hakhyun.2023@gmail.com">hakhyun.2023@gmail.com</a>
      <a class="btn" href="https://github.com/Hakhyun-Kim" target="_blank" rel="noopener">GitHub</a>
      <a class="btn" href="https://www.linkedin.com/in/hakhyunkim/" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 5.5rem 0 3.5rem;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(60rem 24rem at 70% -10%, var(--accent-soft), transparent 60%);
  }

  .hello {
    color: var(--text-soft);
    font-size: 1.05rem;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0.2rem 0 1rem;
  }

  .tagline {
    max-width: 46rem;
    font-size: 1.15rem;
    color: var(--text-soft);
  }

  .now {
    max-width: 46rem;
    margin-top: 0.8rem;
    color: var(--text-soft);
    font-size: 0.97rem;
  }

  .talks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .talk {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.2rem;
  }

  .talk h3 {
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }

  .talk p {
    color: var(--text-soft);
    font-size: 0.92rem;
  }

  .slides-title {
    margin: 1.8rem 0 0.5rem;
    font-size: 1.05rem;
    color: var(--text-soft);
  }

  .slide-list {
    list-style: none;
    display: grid;
    gap: 0.15rem;
  }

  .slide-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    color: var(--text);
  }

  .slide-list a:hover {
    background: var(--bg-card);
    text-decoration: none;
  }

  .slide-list a:hover .slide-name {
    color: var(--accent);
  }

  .slide-name {
    word-break: keep-all;
  }

  .slide-meta {
    color: var(--text-faint);
    font-size: 0.85rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .slides-more {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-faint);
    padding-left: 0.7rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.8rem;
    margin: 1.6rem 0 2rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.55em 1.2em;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text);
    font-weight: 600;
    font-size: 0.97rem;
  }

  .btn:hover {
    text-decoration: none;
    border-color: var(--text-faint);
  }

  .btn-primary {
    background: var(--gradient);
    border: none;
    color: #fff;
  }

  .btn-primary:hover {
    filter: brightness(1.08);
  }

  .ko {
    font-size: 0.82em;
    color: inherit;
    opacity: 0.7;
    margin-left: 0.3em;
  }

  .skills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    max-width: 46rem;
  }

  .section {
    padding-top: 4rem;
  }

  .section-note {
    color: var(--text-soft);
    margin: -0.8rem 0 1.6rem;
  }

  /* timeline */
  .timeline {
    list-style: none;
    border-left: 2px solid var(--border);
    padding-left: 1.6rem;
    margin-left: 0.4rem;
    display: grid;
    gap: 2rem;
  }

  .timeline > li {
    position: relative;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1.6rem - 7px);
    top: 0.5rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gradient);
  }

  .tl-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tl-head h3 {
    font-size: 1.15rem;
  }

  .tl-period {
    color: var(--text-faint);
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .tl-role {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.98rem;
  }

  .tl-loc {
    color: var(--text-faint);
    font-weight: 400;
  }

  .tl-points {
    margin-top: 0.4rem;
    padding-left: 1.2rem;
    color: var(--text-soft);
    font-size: 0.97rem;
  }

  /* project cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.4rem;
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }

  .card img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-bottom: 1px solid var(--border);
  }

  .card-body {
    padding: 1.1rem 1.2rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-body h3 {
    font-size: 1.08rem;
  }

  .card-body h3 a {
    color: inherit;
    text-decoration: none;
  }

  .card-body h3 a:hover {
    text-decoration: underline;
  }

  .card-body p {
    color: var(--text-soft);
    font-size: 0.94rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  /* posts */
  .post-list {
    list-style: none;
    display: grid;
    gap: 0.2rem;
  }

  .post-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    border-radius: 10px;
    color: var(--text);
  }

  .post-list a:hover {
    background: var(--bg-card);
    text-decoration: none;
  }

  .post-list a:hover .post-title {
    color: var(--accent);
  }

  .post-list time {
    color: var(--text-faint);
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .more {
    font-weight: 600;
  }

  .contact-links {
    display: flex;
    gap: 0.8rem;
    margin-top: 1.2rem;
    flex-wrap: wrap;
  }
</style>
