<script is:inline>
  (function () {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    function setActiveTab(category, updateHash = true) {
      if (!category) category = 'career';

      tabs.forEach((tab) => {
        const cat = tab.getAttribute('data-category');
        if (cat === category) {
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
        } else {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
        }
      });

      panels.forEach((panel) => {
        const panelCat = panel.getAttribute('data-category');
        if (category === 'all' || panelCat === category) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });

      if (updateHash) {
        history.replaceState(null, '', '#' + category);
      }
    }

    function initFromHash() {
      const hash = window.location.hash.replace('#', '').trim();
      const validCategories = ['career', 'projects', 'research', 'opensource', 'blog', 'all'];
      if (validCategories.includes(hash)) {
        setActiveTab(hash, false);
      } else {
        setActiveTab('career', false);
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const cat = tab.getAttribute('data-category');
        setActiveTab(cat, true);
      });
    });

    window.addEventListener('hashchange', initFromHash);
    initFromHash();
  })();
</script>

