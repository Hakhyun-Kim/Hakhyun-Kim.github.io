const skills = [
  { en: 'C / C++', ko: 'C / C++' },
  { en: 'Python', ko: 'Python' },
  { en: 'TypeScript', ko: 'TypeScript' },
  { en: 'Unreal Engine · Unity', ko: 'Unreal Engine · Unity' },
  { en: 'Real-time 3D & graphics', ko: '실시간 3D & 그래픽스' },
  { en: 'Simulation (CARLA · Isaac Sim)', ko: '시뮬레이션(CARLA · Isaac Sim)' },
  { en: 'AI-agent workflows', ko: 'AI 에이전트 워크플로우' },
  { en: 'On-chain (Solidity)', ko: '온체인(Solidity)' },
];

const title = isKo
  ? '김학현 — 실시간 3D & 게임 개발'
  : 'Hakhyun Kim — Real-time 3D & Game Development';
const description = isKo
  ? '김학현 — 게임 엔진, XR, 자율주행 시뮬레이션, AI 도구를 활용한 게임 개발 경력과 프로젝트를 정리했습니다.'
  : 'Hakhyun Kim — Real-time 3D software engineer, game engines, XR, simulation, and AI-assisted game development.';
const alternate = isKo ? '/' : '/ko/';
---

<Base title={title} description={description} lang={lang} alternate={alternate} autoRedirect={!isKo}>
  <!-- Hero / Resume Top Header -->
  <section class="hero">
    <div class="container">
      {isKo ? (
        <p class="hello">안녕하세요 👋 실시간 소프트웨어 엔지니어</p>
      ) : (
        <p class="hello">Hello 👋 Real-Time Software Engineer</p>
      )}
      <h1>Hakhyun <span class="gradient-text">Kim</span></h1>
      {isKo ? (
        <p class="tagline">
          게임 엔진, XR, 자율주행 시뮬레이션 등 실시간 소프트웨어를 제작해온 엔지니어입니다. 최근에는 AI 도구를 활용하여 다양한 게임 개발 프로젝트 등을 진행하고 있습니다.
        </p>
      ) : (
        <p class="tagline">
          Real-time software engineer working across game engines, XR, and simulation — currently building game projects with AI tools.
        </p>
      )}
      
      <div class="hero-actions">
        <a class="btn btn-primary" href="mailto:hakhyun.2023@gmail.com">
          ✉️ {isKo ? '이메일 문의' : 'Contact via Email'}
        </a>
        <a class="btn" href="https://github.com/Hakhyun-Kim" target="_blank" rel="noopener">
          GitHub ↗
        </a>
        <a class="btn" href="https://www.linkedin.com/in/hakhyunkim/" target="_blank" rel="noopener">
          LinkedIn ↗
        </a>
      </div>

      <ul class="skills" aria-label="Core skills">
        {skills.map((s) => <li class="chip">{s[lang]}</li>)}
      </ul>
    </div>
  </section>

  <!-- Sticky Category Navigation Bar -->
  <div class="category-nav-wrapper">
    <div class="container">
      <nav class="category-nav" aria-label="Content categories">
        <button class="tab-btn active" data-category="career">
          💼 {isKo ? '경력' : 'Career'}
        </button>
        <button class="tab-btn" data-category="projects">
          🚀 {isKo ? '프로젝트' : 'Projects'}
        </button>
        <button class="tab-btn" data-category="research">
          🔬 {isKo ? '연구 & 스터디' : 'Research'}
        </button>
        <button class="tab-btn" data-category="opensource">
          🌐 {isKo ? '오픈소스 & 발표' : 'Open Source & Talks'}
        </button>
        <button class="tab-btn" data-category="blog">
          ✍️ {isKo ? '블로그' : 'Blog'}
        </button>
        <button class="tab-btn" data-category="all">
          📄 {isKo ? '전체 보기' : 'View All'}
        </button>
      </nav>
    </div>
  </div>

  <div class="container main-content-area">
    <!-- Category 1: Career Resume (Default View) -->
    <section id="career" class="tab-panel section-panel" data-category="career">
      <div class="section-header-box">
        <h2 class="section-title">{isKo ? '경력' : 'Career'}</h2>
        <p class="section-note">
          {isKo
            ? '2003년부터 지금까지 이어온 엔진, 미들웨어, XR, 시뮬레이션, 온체인 개발 기록입니다. 각 항목을 클릭하여 세부 기술 스택과 성과를 확인하실 수 있습니다.'
            : 'Twenty-odd years of engineering — engines, middleware, XR, simulation, and on-chain. Click "+ View details" to expand technical highlights.'}
        </p>
      </div>

      <div class="career-list">
        {
          experience.map((job) => (
            <article class="career-card">
              <div class="career-top">
                <div class="career-title-row">
                  <h3>{job.company}</h3>
                  <span class="tl-period">{job.period}</span>
                </div>
                <p class="tl-role">
                  {job.role} · <span class="tl-loc">{job.location[lang]}</span>
                </p>
                <p class="tl-summary">{job.summary[lang]}</p>
              </div>

              <details class="career-details">
                <summary class="details-toggle">
                  <span class="toggle-text-more">{isKo ? '+ 세부 성과 및 내용 보기' : '+ View details & highlights'}</span>
                  <span class="toggle-text-less">{isKo ? '- 상세 내용 접기' : '- Collapse details'}</span>
                </summary>
                <div class="details-content">
                  <ul class="highlights-list">
                    {job.highlights[lang].map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </details>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Category 2: Projects -->
    <section id="projects" class="tab-panel section-panel hidden" data-category="projects">
      <div class="section-header-box">
        <h2 class="section-title">{isKo ? '주요 프로젝트' : "Featured Projects"}</h2>
